/writing/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/work
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/work/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/videos
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/courses
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/courses/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/news
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/chat
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

# ---------- 带内容哈希的静态资源：永久缓存 ----------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable
